{
  "name": "flowtherapy-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private campaign studio — validated data core",
  "scripts": {
    "schemas": "node scripts/schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "node scripts/schemas.mjs --check && npm run typecheck && npm test && node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-json-schema": "^0.68.0"
  }
}
