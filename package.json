{
  "name": "flowtherapy-studio",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Private campaign studio — local editor",
  "scripts": {
    "schemas": "node scripts/schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "node scripts/schemas.mjs --check && npm run typecheck && npm test && node scripts/check.mjs && npm run build",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-json-schema": "^0.68.0",
    "vite": "^8.3.0"
  }
}
